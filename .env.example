# CNC SmartCore Unified Platform - Environment Configuration Template
# COPY TO .env.local OR APPROPRIATE SERVICE ENV - NEVER COMMIT REAL SECRETS

# ==========================================
# Shared Supabase Configuration
# ==========================================
# Public (Browser safe):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server only (NEVER expose to frontend or git):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
SUPABASE_DB_PASSWORD=your-database-password-placeholder

# ==========================================
# 3 Separate Database Connections
# ==========================================
# 1. Module 1 CNC Monitoring Database
M1_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cnc_m1_db
M1_DATASOURCE_USERNAME=postgres
M1_DATASOURCE_PASSWORD=your-m1-password-placeholder

# 2. Module 2 Pre-Manufacturing Database
M2_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cnc_m2_db
M2_DATASOURCE_USERNAME=postgres
M2_DATASOURCE_PASSWORD=your-m2-password-placeholder

# 3. Unified Identity, Registration & Bridge Database
UNIFIED_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cnc_unified_db
UNIFIED_DATASOURCE_USERNAME=postgres
UNIFIED_DATASOURCE_PASSWORD=your-unified-password-placeholder

# ==========================================
# Service Ports & Proxy URLs (Dev Defaults)
# ==========================================
SHELL_PORT=5173
M2_FRONTEND_PORT=5174
M1_FRONTEND_PORT=5175
M2_BACKEND_PORT=8080
M1_BACKEND_PORT=8082
GEOMETRY_SERVICE_PORT=8000
M1_ML_SERVICE_PORT=8001
REDIS_PORT=6379

# Internal Service Keys
INTERNAL_API_KEY=your-internal-geometry-service-key-placeholder
CNC_ML_SERVICE_API_KEY=your-internal-ml-service-key-placeholder
